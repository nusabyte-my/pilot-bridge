# Optional: Gemma 4 via Gemini API. The application works with explicit demo drafts without it.
GEMINI_API_KEY=
GEMINI_MODEL=gemma-4-27b-it
# Optional: LiteLLM-compatible inference for the multi-agent orchestrator.
# Store a rotated server-side key. Never expose this value to the browser.
LITELLM_API_KEY=
LITELLM_BASE_URL=https://litellm.rapidscreen.io/v1
LITELLM_MODEL=deepseek-v4.1-flash
PILOTBRIDGE_DB=./data/pilotbridge.db
# Enables the one-click fictional demo session. Keep false for real user data.
PILOTBRIDGE_DEMO_LOGIN=false
